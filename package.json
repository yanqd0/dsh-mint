{
  "name": "@yanqd0/dsh-mint",
  "version": "0.3.0-alpha.1",
  "description": "mint issue tracking inside DSH sessions: a zero-approval host `mint` tool with the bundled mint skill, session context injection, plan binding and commit reminders; a read-only mint panel in the right sidebar (add-tab menu, beside Workspace files and New terminal) shows this project's issues, plans and milestones.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanqd0/dsh-mint.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mint",
    "issue",
    "tracker",
    "plugin"
  ],
  "files": [
    "dist",
    "cordis.patch.yml",
    "scripts/install-skill-postinstall.mjs",
    "locale/*.json"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup && node scripts/build-client.mjs && node scripts/build-skill.mjs",
    "postinstall": "node scripts/install-skill-postinstall.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "mint-faa": ">=0.8.0 <1.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "react": "~18.3.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
